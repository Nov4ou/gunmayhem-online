[Unit]
Description=Gun Mayhem Online
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/gunmayhem/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
